.env
# Ignore reports/ CONTENTS (not the dir itself) so the monthly-overlay-readiness
# CI can commit its readiness markdowns. A dir-level `reports/` ignore stops git
# descending in, and a later `!` cannot re-include children of an ignored dir —
# so it MUST be `reports/*` for the un-ignore below to take effect.
reports/*
!reports/overlay_readiness_*.md
*.log
__pycache__/
*.pyc

# backtest analysis artifacts (regenerable via run_backtest.py)
backtest_*.txt

# Round2 runtime artifacts
.cache/
run_*.log
rank_ic.txt
netlify-ref.png
r3-stockcard.png
*.png

# internal batch-planning bridge (not for public repo)
REMAINING_BATCHES.md
.playwright-mcp/

# internal harness config / scratch (not for public repo)
.claude/
.tmp_font/
.github/skills/

# #3 keyless all-market OHLC panel — large + reconstructable from daily snapshots;
# persisted via the CI rolling cache, never committed. Only its scored OUTPUT
# (docs/data/_verdicts.json) is served.
docs/data/_panel.json.gz

# 15y backtest scratch + intermediate sanitize artifacts (regenerable)
_event_15y_partial.json
*_pre_sanitize.json
# NOTE: universe_15y_draft.csv is NOW committed (pinned universe) — the offline
# monthly-revalidation + robustness CI jobs check it out by name; gitignoring it
# made those jobs fail-fast (FileNotFoundError) in a clean CI checkout.

# Service account / credential files — never commit these
*.pem
credentials.json
service-account*.json
google-sa*.json
*_sa.json
.env.*
!.env.example

# Local cron runtime logs — do not commit
tools/local_cron/logs/*.log
